# ════════════════════════════════════════════════════════════════════════
#  🎤 Hatsune Miku Bot — credenciais do Discord Developer Portal
#  Copia este ficheiro para  .env  e preenche com os teus dados.
#  Encontras tudo em: https://discord.com/developers/applications
# ════════════════════════════════════════════════════════════════════════

# ── General Information ─────────────────────────────────────────────────
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# ── Bot → Reset Token ───────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── OAuth2 ──────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Painel web ──────────────────────────────────────────────────────────
# Deixa vazio para gerar um automaticamente (é mostrado no arranque).
DASHBOARD_TOKEN=
WEB_HOST=0.0.0.0
WEB_PORT=8787
# true = o painel liga-se sozinho ao bot (recomendado).
AUTO_CONNECT=true

# ── Intents (liga-os em Bot → Privileged Gateway Intents) ───────────────
INTENT_MEMBERS=true
INTENT_MESSAGE_CONTENT=true
INTENT_PRESENCES=false

# ── Comandos de chat ────────────────────────────────────────────────────
COMMAND_PREFIX=!
